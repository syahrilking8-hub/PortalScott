<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#020617">

    <!-- Background Animasi Partikel -->
    <com.app.portal.ui.ParticlesView
        android:id="@+id/particlesBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Intro Text Splash -->
    <TextView
        android:id="@+id/tvIntro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="Created by Scott Reeves"
        android:textColor="#fbbf24"
        android:textSize="22sp"
        android:textStyle="bold"
        android:visibility="visible" />

    <!-- Root Form Container -->
    <RelativeLayout
        android:id="@+id/layoutMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:padding="16dp"
        android:visibility="gone">

        <!-- Tombol Logout Link (Pojok Kiri Atas) -->
        <Button
            android:id="@+id/btnLogoutLink"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_marginStart="8dp"
            android:layout_marginTop="12dp"
            android:paddingHorizontal="12dp"
            android:text="Logout Link"
            android:textAllCaps="false"
            android:textColor="#F59E0B"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Main Card Scrollable -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cardLogin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="24dp"
                    app:layout_constraintWidth_max="420dp">

                    <TextView
                        android:id="@+id/tvTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Portal Data Siswa"
                        android:textColor="#f8fafc"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        app:layout_constraintTop_toTopOf="parent" />

                    <!-- Form Section -->
                    <LinearLayout
                        android:id="@+id/formContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical"
                        app:layout_constraintTop_toBottomOf="@id/tvTitle">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Username"
                            android:textColor="#94a3b8"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/etUsername"
                            android:layout_width="match_parent"
                            android:layout_height="45dp"
                            android:layout_marginTop="6dp"
                            android:hint="Masukkan username"
                            android:inputType="text"
                            android:paddingHorizontal="14dp"
                            android:textColor="#f8fafc"
                            android:textColorHint="#475569"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Password"
                            android:textColor="#94a3b8"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/etPassword"
                            android:layout_width="match_parent"
                            android:layout_height="45dp"
                            android:layout_marginTop="6dp"
                            android:hint="Masukkan password"
                            android:inputType="textPassword"
                            android:paddingHorizontal="14dp"
                            android:textColor="#f8fafc"
                            android:textColorHint="#475569"
                            android:textSize="14sp" />

                        <Button
                            android:id="@+id/btnLogin"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="20dp"
                            android:text="MASUK"
                            android:textColor="#020617"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <!-- Bottom Action Bar inside Card -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp">

                            <LinearLayout
                                android:id="@+id/layoutIndicator"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:layout_centerVertical="true"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <View
                                    android:id="@+id/dotStatus"
                                    android:layout_width="10dp"
                                    android:layout_height="10dp"
                                    android:layout_marginEnd="8dp" />

                                <TextView
                                    android:id="@+id/tvStatusLink"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="link belum terisi"
                                    android:textColor="#ef4444"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvToRegister"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:text="Sign Up"
                                android:textColor="#fbbf24"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </RelativeLayout>

                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>
        </ScrollView>
    </RelativeLayout>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#020617">

    <!-- Background Animasi Partikel -->
    <com.app.portal.ui.ParticlesView
        android:id="@+id/particlesBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Intro Text Splash -->
    <TextView
        android:id="@+id/tvIntro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="Created by Scott Reeves"
        android:textColor="#fbbf24"
        android:textSize="22sp"
        android:textStyle="bold"
        android:visibility="visible" />

    <!-- Root Form Container -->
    <RelativeLayout
        android:id="@+id/layoutMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:padding="16dp"
        android:visibility="gone">

        <!-- Tombol Logout Link (Pojok Kiri Atas) -->
        <Button
            android:id="@+id/btnLogoutLink"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentLeft="true"
            android:layout_marginTop="12dp"
            android:layout_marginStart="8dp"
            android:text="Logout Link"
            android:textColor="#F59E0B"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:paddingHorizontal="12dp"
            android:visibility="gone" />

        <!-- Main Card Scrollable -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_marginHorizontal="8dp"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/cardLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Portal Data Siswa"
                    android:textColor="#f8fafc"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <!-- Form Section -->
                <LinearLayout
                    android:id="@+id/formContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="Username"
                        android:textColor="#94a3b8"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etUsername"
                        android:layout_width="match_parent"
                        android:layout_height="45dp"
                        android:layout_marginTop="6dp"
                        android:hint="Masukkan username"
                        android:inputType="text"
                        android:paddingHorizontal="14dp"
                        android:textColor="#f8fafc"
                        android:textColorHint="#475569"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Password"
                        android:textColor="#94a3b8"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etPassword"
                        android:layout_width="match_parent"
                        android:layout_height="45dp"
                        android:layout_marginTop="6dp"
                        android:hint="Masukkan password"
                        android:inputType="textPassword"
                        android:paddingHorizontal="14dp"
                        android:textColor="#f8fafc"
                        android:textColorHint="#475569"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/btnLogin"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="22dp"
                        android:text="MASUK"
                        android:textColor="#020617"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <!-- Bottom Action Bar inside Card -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp">

                        <!-- Indikator Link (Kiri) -->
                        <LinearLayout
                            android:id="@+id/layoutIndicator"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentLeft="true"
                            android:layout_centerVertical="true"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:id="@+id/dotStatus"
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:layout_marginEnd="8dp" />

                            <TextView
                                android:id="@+id/tvStatusLink"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="link belum terisi"
                                android:textColor="#ef4444"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Tombol Sign Up (Kanan) -->
                        <TextView
                            android:id="@+id/tvToRegister"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentRight="true"
                            android:layout_centerVertical="true"
                            android:text="Sign Up"
                            android:textColor="#fbbf24"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </RelativeLayout>

                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </RelativeLayout>
</FrameLayout>

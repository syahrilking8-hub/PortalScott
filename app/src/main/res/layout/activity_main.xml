<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainRootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090D16">

    <!-- Particles View Background -->
    <com.app.portal.ui.ParticlesView
        android:id="@+id/particlesView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Container Center Presisi di Tengah Layar -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginVertical="12dp"
        android:orientation="vertical"
        app:layout_constraintWidth_max="920dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Top Header Navigation -->
        <RelativeLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Portal Data Siswa"
                        android:textColor="#F8FAFC"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/btnRefresh"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="10dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:src="@android:drawable/ic_popup_sync"
                        app:tint="#F59E0B" />
                </LinearLayout>

                <!-- Teks Pengganti 'USER' - Menampilkan Role Badge Gaya Web -->
                <TextView
                    android:id="@+id/tvRole"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="#2238BDF8"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="ROLE: ADMIN"
                    android:textColor="#38BDF8"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Button
                android:id="@+id/btnLogout"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:backgroundTint="#00000000"
                android:text="Logout"
                android:textAllCaps="false"
                android:textColor="#F59E0B"
                android:textSize="13sp" />
        </RelativeLayout>

        <!-- Tombol Tambah Siswa Pas di Kiri Atas Luar Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnAddStudent"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:paddingHorizontal="16dp"
                android:text="+ Tambah Siswa"
                android:textAllCaps="false"
                android:textColor="#020617"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Card Tabel Glassmorphism dengan Opacity 60% (#990F172A) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardTable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#990F172A"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:overScrollMode="never">

                <TableLayout
                    android:id="@+id/tableStudents"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stretchColumns="1,2">

                    <!-- Table Header -->
                    <TableRow
                        android:background="#1E293B"
                        android:paddingVertical="10dp">

                        <TextView
                            android:layout_width="50dp"
                            android:gravity="center"
                            android:text="NO"
                            android:textColor="#F59E0B"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="120dp"
                            android:gravity="center"
                            android:text="NIS"
                            android:textColor="#F59E0B"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="180dp"
                            android:gravity="center"
                            android:text="NAMA SISWA"
                            android:textColor="#F59E0B"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="200dp"
                            android:gravity="center"
                            android:text="ALAMAT"
                            android:textColor="#F59E0B"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="210dp"
                            android:gravity="center"
                            android:text="AKSI"
                            android:textColor="#F59E0B"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </TableRow>

                </TableLayout>
            </ScrollView>
        </androidx.cardview.widget.CardView>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

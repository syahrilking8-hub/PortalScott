<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainRootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090D16">

    <!-- Background Partikel -->
    <com.app.portal.ui.ParticlesView
        android:id="@+id/particlesView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Header Navigation -->
    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Portal Data Siswa"
                    android:textColor="#F8FAFC"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/btnRefresh"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:src="@android:drawable/ic_popup_sync"
                    app:tint="#F59E0B" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvRole"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:background="#2238BDF8"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="• Selamat Datang di Panel Data Siswa"
                android:textColor="#38BDF8"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:backgroundTint="#00000000"
            android:text="Logout"
            android:textAllCaps="false"
            android:textColor="#F59E0B"
            android:textSize="13sp" />
    </RelativeLayout>

    <!-- Top Action Bar: Tambah Siswa & Search Bar -->
    <LinearLayout
        android:id="@+id/actionContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnAddStudent"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:paddingHorizontal="14dp"
            android:text="+ Tambah Siswa"
            android:textAllCaps="false"
            android:textColor="#020617"
            android:textSize="13sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Search Bar Opacity 45% (#730F172A) -->
        <EditText
            android:id="@+id/etSearch"
            android:layout_width="180dp"
            android:layout_height="38dp"
            android:background="#730F172A"
            android:hint="🔍 Cari nama/NIS..."
            android:paddingHorizontal="12dp"
            android:singleLine="true"
            android:textColor="#F8FAFC"
            android:textColorHint="#94A3B8"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Card Wrapper Utama (Centering Strict & High Dynamic Limit) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardTable"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:layout_marginHorizontal="16dp"
        app:cardBackgroundColor="#990F172A"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:layout_constraintWidth_max="920dp"
        app:layout_constraintTop_toBottomOf="@id/actionContainer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.0">

        <!-- Inner Container Dengan Padding Agar Terlihat Simetris Seperti Di Web -->
        <LinearLayout
            android:id="@+id/cardInnerContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Support Scroll Vertikal (Tabel Tetap Scroll Di Dalam Card) -->
            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxHeight="380dp"
                android:fillViewport="true">

                <!-- Support Scroll Horizontal -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="horizontal">

                    <TableLayout
                        android:id="@+id/tableStudents"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <!-- Table Header -->
                        <TableRow
                            android:background="#1E293B"
                            android:paddingVertical="10dp">

                            <TextView
                                android:layout_width="55dp"
                                android:gravity="center"
                                android:text="NO"
                                android:textColor="#F59E0B"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="130dp"
                                android:gravity="center"
                                android:text="NIS"
                                android:textColor="#F59E0B"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="200dp"
                                android:gravity="center"
                                android:text="NAMA SISWA"
                                android:textColor="#F59E0B"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="220dp"
                                android:gravity="center"
                                android:text="ALAMAT"
                                android:textColor="#F59E0B"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="220dp"
                                android:gravity="center"
                                android:text="AKSI"
                                android:textColor="#F59E0B"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </TableRow>

                    </TableLayout>
                </HorizontalScrollView>
            </androidx.core.widget.NestedScrollView>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>

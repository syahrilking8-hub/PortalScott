<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/cardDialogDetail"
            android:layout_width="340dp"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="Biodata Diri Siswa"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_marginBottom="16dp">

                <View
                    android:id="@+id/vAvatarGlow"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <ImageView
                    android:id="@+id/ivDetailFoto"
                    android:layout_width="102dp"
                    android:layout_height="102dp"
                    android:layout_gravity="center"
                    android:scaleType="centerCrop" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/subcardBiodata"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="6dp">
                    <TextView android:layout_width="90dp" android:layout_height="wrap_content" android:text="NIS" android:textColor="#94A3B8" android:textSize="12sp" android:textStyle="bold" />
                    <TextView android:id="@+id/tvDetailNis" android:layout_width="match_parent" android:layout_height="wrap_content" android:text=": -" android:textColor="#F59E0B" android:textSize="12sp" android:textStyle="bold" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#2238BDF8" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="6dp">
                    <TextView android:layout_width="90dp" android:layout_height="wrap_content" android:text="NAMA" android:textColor="#94A3B8" android:textSize="12sp" android:textStyle="bold" />
                    <TextView android:id="@+id/tvDetailNama" android:layout_width="match_parent" android:layout_height="wrap_content" android:text=": -" android:textColor="#F8FAFC" android:textSize="12sp" android:textStyle="bold" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#2238BDF8" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="6dp">
                    <TextView android:layout_width="90dp" android:layout_height="wrap_content" android:text="TTL" android:textColor="#94A3B8" android:textSize="12sp" android:textStyle="bold" />
                    <TextView android:id="@+id/tvDetailTtl" android:layout_width="match_parent" android:layout_height="wrap_content" android:text=": -" android:textColor="#F8FAFC" android:textSize="12sp" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#2238BDF8" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="6dp">
                    <TextView android:layout_width="90dp" android:layout_height="wrap_content" android:text="ALAMAT" android:textColor="#94A3B8" android:textSize="12sp" android:textStyle="bold" />
                    <TextView android:id="@+id/tvDetailAlamat" android:layout_width="match_parent" android:layout_height="wrap_content" android:text=": -" android:textColor="#F8FAFC" android:textSize="12sp" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#2238BDF8" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="6dp">
                    <TextView android:layout_width="90dp" android:layout_height="wrap_content" android:text="HOBI" android:textColor="#94A3B8" android:textSize="12sp" android:textStyle="bold" />
                    <TextView android:id="@+id/tvDetailHobi" android:layout_width="match_parent" android:layout_height="wrap_content" android:text=": -" android:textColor="#F8FAFC" android:textSize="12sp" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#2238BDF8" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="6dp">
                    <TextView android:layout_width="90dp" android:layout_height="wrap_content" android:text="CITA - CITA" android:textColor="#94A3B8" android:textSize="12sp" android:textStyle="bold" />
                    <TextView android:id="@+id/tvDetailCitaCita" android:layout_width="match_parent" android:layout_height="wrap_content" android:text=": -" android:textColor="#F8FAFC" android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/btnCloseDetail"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="TUTUP BIODATA"
                android:textAllCaps="true"
                android:textColor="#020617"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
